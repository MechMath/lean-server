{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-server.local/protocol/v1/result.schema.json",
  "$defs": {
    "position": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 0}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message", "file_name", "start", "end"],
      "properties": {
        "severity": {"enum": ["warning", "error"]},
        "message": {"type": "string"},
        "file_name": {"type": ["string", "null"]},
        "start": {"$ref": "#/$defs/position"},
        "end": {"$ref": "#/$defs/position"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "type",
    "request_id",
    "status",
    "compile_ms",
    "warnings",
    "errors"
  ],
  "properties": {
    "protocol_version": {"const": 1},
    "type": {"const": "result"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "compile_error", "internal_error"]},
    "compile_ms": {"type": "number", "minimum": 0},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  }
}
