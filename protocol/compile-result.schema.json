{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-server.local/protocol/compile-result.schema.json",
  "$defs": {
    "position": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "message",
        "file_name",
        "start",
        "end"
      ],
      "properties": {
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "elaborationTimings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_ms",
        "elaboration_ms",
        "diagnostics_ms",
        "profiling_ms"
      ],
      "properties": {
        "header_ms": {
          "type": "number",
          "minimum": 0
        },
        "elaboration_ms": {
          "type": "number",
          "minimum": 0
        },
        "diagnostics_ms": {
          "type": "number",
          "minimum": 0
        },
        "profiling_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "type",
    "request_id",
    "status",
    "compile_ms",
    "warnings",
    "errors"
  ],
  "properties": {
    "protocol_version": {
      "const": 2
    },
    "type": {
      "const": "result"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "compile_error",
        "internal_error"
      ]
    },
    "compile_ms": {
      "type": "number",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "timings": {
      "$ref": "#/$defs/elaborationTimings"
    }
  }
}
